main { padding: 2rem; max-width: 1152px; margin: 0 auto; }
.grid { display: grid; gap: 1rem; }
.g2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
.g4 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

/* --- Components --- */
.card { background-color: var(--card); border: 1px solid var(--bd); border-radius: 1rem; padding: 1.5rem; }
.card.hero { background: linear-gradient(to bottom right, rgba(129, 140, 248, 0.1), rgba(167, 139, 250, 0.05)); border-color: rgba(129, 140, 248, 0.3); }
.card h3 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mut); margin: 0 0 0.5rem 0; font-weight: 600; }

/* --- Typography --- */
.big { font-size: 2rem; font-weight: 800; margin: 0.25rem 0; }
.sub { font-size: 0.875rem; color: var(--mut); }
.pos { color: var(--ok); }
.neg { color: var(--bad); }
.logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.025em; }
.logo i { color: var(--ac2); font-style: normal; }

/* --- Controls --- */
button { cursor: pointer; font-family: inherit; font-size: 0.875rem; transition: 0.2s; }
button:disabled { opacity: 0.5; cursor: not-allowed; }
button.p { background: linear-gradient(to bottom right, var(--ac), var(--ac2)); color: var(--bg); font-weight: 600; padding: 0.5rem 1rem; border-radius: 0.75rem; border: none; }
button.p:hover:not(:disabled) { opacity: 0.9; }
button.s { background: transparent; border: 1px solid var(--bd); color: var(--tx); padding: 0.5rem 1rem; border-radius: 0.75rem; }
button.s:hover:not(:disabled) { border-color: var(--ac); }
button.x { background: transparent; color: var(--mut); border: none; font-size: 1.25rem; padding: 0.5rem; }
button.x:hover { color: var(--tx); }

nav { display: flex; gap: 0.5rem; }
nav button { background: transparent; border: none; color: var(--mut); padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 500; }
nav button:hover { color: var(--tx); }
nav button.on { background: var(--bd); color: var(--tx); }

.form { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
.form input, .form select { background: var(--bg); border: 1px solid var(--bd); color: var(--tx); padding: 0.5rem 1rem; border-radius: 0.5rem; outline: none; font-family: inherit; }
.form input:focus, .form select:focus { border-color: var(--ac); }

/* --- Dashboard Elements --- */
.bar { height: 0.5rem; background: var(--bd); border-radius: 999px; overflow: hidden; margin: 0.5rem 0; width: 100%; }
.bar i { display: block; height: 100%; border-radius: 999px; transition: width 0.3s; }

.tx { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--bd); }
.tx:last-child { border-bottom: none; }
.dot { width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; display: grid; place-items: center; font-weight: bold; color: var(--bg); flex-shrink: 0; }
.m { flex: 1; display: flex; flex-direction: column; }

.lock { padding: 2rem; text-align: center; background: rgba(13, 15, 21, 0.8); border: 1px solid var(--bd); border-radius: 0.75rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: 1rem; }
.center { display: flex; min-height: 100vh; align-items: center; justify-content: center; text-align: center; }

