  /* 4. Transactions form: stacked, full-width, big touch targets */
  .txform { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .txform .txform-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .txform .txbtn {
