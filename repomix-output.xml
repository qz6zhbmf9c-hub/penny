}
.link { background: none; border: 0; color: var(--ac); cursor: pointer; font: inherit; padding: 0; font-weight: 600; }
.link:hover { text-decoration: underline; }
.err { color: var(--bad); font-size: 13px; margin: 0; }

/* --- Profile & Delete Account --- */
.badge { display: inline-block; padding: 3px 10px; border-radius: 99px; font-size: 12px; font-weight: 700; background: var(--bd); color: var(--mut); }
.badge.ok { background: color-mix(in srgb, var(--ok) 18%, transparent); color: var(--ok); }
.badge.pro { background: linear-gradient(135deg, var(--ac), var(--ac2)); color: #fff; }
.prow { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--bd); }
.prow:last-child { border: 0; }
.stars { display: flex; gap: 4px; }
.star { background: none; border: 0; font-size: 32px; line-height: 1; cursor: pointer; color: var(--bd); padding: 0; }
.star.on { color: #f59e0b; }
.danger { background: var(--bad); color: #fff; border: 0; border-radius: 0.75rem; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; }
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--bad) 50%,transparent)}50%{box-shadow:0 0 0 8px transparent}}
.mic.rec{border-color:var(--bad);animation:pulse 1.1s infinite}
