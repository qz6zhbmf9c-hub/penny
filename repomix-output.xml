  animation: rise 1.1s 0.4s var(--ease-out-expo) both;
}

.lp .sandbox-head {
  text-align: center;
  margin-bottom: 20px;
}

.lp .sandbox-hint {
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
  margin: 10px 0 0;
}

.lp .sandbox-shell {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid var(--bd);
  background: var(--s1);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 1),
    0 35px 90px -20px rgba(14, 27, 51, 0.6),
    0 0 70px -10px rgba(217, 179, 91, 0.22);
}

.lp .sandbox-chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 18px;
  background: rgba(255, 255, 255, 0.5);
  border-bottom: 1px solid var(--bd);
}

.lp .chrome-dots {
  display: flex;
  gap: 7px;
}

.lp .chrome-dots span {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: rgba(14, 27, 51, 0.2);
}

.lp .chrome-dots span:nth-child(1) { background: #E5566D; }
.lp .chrome-dots span:nth-child(2) { background: #E3C16F; }
.lp .chrome-dots span:nth-child(3) { background: #9AA9C8; }

.lp .chrome-url {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--mut);
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--bd);
  padding: 5px 16px;
  border-radius: 99px;
}

.lp .chrome-replay {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--bd);
  color: var(--tx);
  font-size: 11px;
  padding: 5px 12px;
  border-radius: 99px;
  cursor: pointer;
}

.lp .chrome-replay:hover {
  border-color: var(--v2);
  background: #fff;
}

/* Apple Liquid Glass 3-Second Welcome Veil */
.lp .liquid-veil {
  position: absolute;
  inset: 45px 0 0 0;
  z-index: 25;
  display: grid;
  place-items: center;
  padding: 24px;
  background: radial-gradient(circle at 50% 50%, rgba(246, 241, 230, 0.85), rgba(232, 218, 184, 0.95));
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  opacity: 0;
  transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), backdrop-filter 0.8s ease;
  cursor: pointer;
}

.lp .liquid-veil.is-in {
  opacity: 1;
}

.lp .liquid-veil.is-out {
  opacity: 0;
  pointer-events: none;
}

.lp .liquid-center {
  text-align: center;
  transform: translateY(10px) scale(0.97);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}

.lp .liquid-veil.is-in .liquid-center {
  transform: translateY(0) scale(1);
}

.lp .liquid-img {
  width: 100%;
  max-width: 720px;
  height: auto;
  margin: 0 auto;
  display: block;
  filter: drop-shadow(0 25px 40px rgba(14, 27, 51, 0.3));
  transform: scale(1.05);
  user-select: none;
  pointer-events: none;
  opacity: 0.95;
}

.lp .liquid-sub {
  display: inline-block;
  margin-top: 14px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--tx);
}

/* Scoped Dashboard Reset inside .lp */
.lp .sandbox-app {
  position: relative;
  text-align: left;
  font-family: ui-sans-serif, system-ui, sans-serif;
  background: var(--s1);
}

.lp .sandbox-app .top {
  position: relative;
  padding: 1rem 1.5rem;
}

.lp .sandbox-body {
  padding: 1.5rem;
  max-height: 680px;
  overflow-y: auto;
}

.lp .sandbox-app h3 {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--mut);
  margin: 0 0 0.5rem 0;
  font-weight: 600;
  text-align: left;
}

.lp .sandbox-app .sub {
  text-align: left;
  max-width: none;
  margin: 0;
  font-size: 0.875rem;
}

.lp .sandbox-app .bar {
  display: block;
  height: 0.5rem;
  background: #ffffff;
  border-radius: 999px;
  overflow: hidden;
  margin: 0.5rem 0;
  padding: 0;
  width: 100%;
  border: 1px solid var(--bd);
}

.lp .sandbox-app .bar::after {
  display: none;
}

.lp .sandbox-toast {
  position: sticky;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  max-width: 90%;
  margin: 0 auto;
  background: var(--tx);
  color: #fff;
  padding: 10px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  box-shadow: 0 12px 30px rgba(14, 27, 51, 0.4);
  z-index: 20;
}

/* Infinite Marquee */
.lp .marquee {
  margin-top: 56px;
  overflow: hidden;
  border-block: 1px solid rgba(217, 179, 91, 0.28);
  background: linear-gradient(90deg, rgba(217, 179, 91, 0.04), rgba(255, 255, 255, 0.05), rgba(217, 179, 91, 0.04));
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
}

.lp .track {
  display: flex;
  width: max-content;
  animation: marq 36s linear infinite;
}

.lp .track ul {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
}

.lp .track li {
  padding: 18px 30px;
  font: 500 12px "JetBrains Mono", monospace;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #ffffff;
  white-space: nowrap;
}

.lp .track li::before {
  content: "✦";
  margin-right: 30px;
  color: #D9B35B;
}

/* Definition & Bento Grid Sections */
.lp .bento {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 16px;
}

.lp .b1 { grid-column: span 7; }
.lp .b2 { grid-column: span 5; }
.lp .b3 { grid-column: span 5; }
.lp .b4 { grid-column: span 7; }
.lp .b5, .lp .b6 { grid-column: span 6; }

.lp .bn {
  position: relative;
  overflow: hidden;
  padding: 26px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 22px;
  min-height: 268px;
  background: var(--s1);
  border-radius: 20px;
  border: 1px solid var(--bd);
  box-shadow: 0 4px 20px -10px rgba(14, 27, 51, 0.15);
  transition: transform 0.45s var(--ease-spring), border-color 0.3s;
}

.lp .bn:hover {
  transform: translateY(-4px);
  border-color: rgba(154, 98, 0, 0.6);
}

.lp .bn h3 {
  font-size: 22px;
  margin: 14px 0 8px;
}

.lp .bn p {
  margin: 0;
  color: var(--mut);
  font-size: 15px;
  line-height: 1.55;
}

.lp .tag {
  display: inline-block;
  padding: 4px 11px;
  border-radius: 99px;
  font-size: 11px;
  font-weight: 600;
  background: rgba(42, 76, 176, 0.10);
  color: #2A4CB0;
  border: 1px solid rgba(42, 76, 176, 0.28);
}

.lp .tag.pro {
  background: linear-gradient(135deg, rgba(243, 226, 170, 0.9), rgba(217, 179, 91, 0.55));
  color: #5C3C00;
  border-color: rgba(154, 98, 0, 0.4);
}

/* Bento Mini-UI Artifacts */
.lp .b-vis {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--bd);
  border-radius: 14px;
  padding: 14px 16px;
}

.lp .b-vis-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}

.lp .mini-stat span {
  display: block;
  font-size: 12px;
  color: var(--mut);
}

.lp .mini-stat .pos {
  font-size: 20px;
  color: var(--g);
}

.lp .mini-bars {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 56px;
  width: 140px;
}

.lp .mini-bars i {
  flex: 1;
  border-radius: 4px;
  background: linear-gradient(var(--v2), var(--v));
  transform-origin: bottom;
  transition: transform 0.5s var(--ease-spring);
}

.lp .mini-bars i.hi {
  background: linear-gradient(#EBCB7E, var(--g));
}

.lp .bn:hover .mini-bars i {
  transform: scaleY(1.14);
}

.lp .b-vis-wave {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.lp .mini-wave {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 32px;
  width: 90px;
}

.lp .mini-wave i {
  flex: 1;
  height: 100%;
  border-radius: 3px;
  background: var(--v2);
  transform: scaleY(0.35);
  animation: eq 1.1s ease-in-out infinite;
}

.lp .mini-wave i:nth-child(2n) { animation-delay: -0.35s; }
.lp .mini-wave i:nth-child(3n) { animation-delay: -0.7s; }

.lp .mini-pill {
  font-size: 12px;
  padding: 5px 10px;
  border-radius: 99px;
  background: rgba(14, 27, 51, 0.1);
  color: var(--v2);
  border: 1px solid rgba(14, 27, 51, 0.25);
}

.lp .mini-receipt {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  color: var(--tx);
  border-radius: 8px;
  padding: 10px 12px;
  border: 1px solid var(--bd);
}

.lp .mini-r-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 700;
}

.lp .mini-r-lines i {
  display: block;
  height: 5px;
  margin-top: 6px;
  border-radius: 3px;
  background: rgba(14, 27, 51, 0.15);
  width: 65%;
}

.lp .mini-r-lines i:last-child {
  width: 40%;
}

.lp .mini-laser {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2px;
  background: #D9A82E;
  box-shadow: 0 0 10px 2px rgba(217, 168, 46, 0.85);
  animation: miniScan 2.4s ease-in-out infinite;
}

.lp .b-vis-meter {
  display: grid;
  gap: 10px;
}

.lp .mini-budget div {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-bottom: 5px;
}

.lp .mini-budget {
  position: relative;
  padding-bottom: 6px;
}

.lp .mini-budget::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 5px;
  border-radius: 3px;
  background: rgba(14, 27, 51, 0.1);
}

.lp .b-fill {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 5px;
  border-radius: 3px;
  z-index: 1;
}

.lp .ok-fill { background: linear-gradient(90deg, var(--g), #EBCB7E); }
.lp .v-fill { background: linear-gradient(90deg, var(--v), var(--v2)); }

.lp .streak-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6px;
}

.lp .streak-days span {
  display: grid;
  place-items: center;
  gap: 2px;
  padding: 6px 4px;
  border-radius: 8px;
  font-size: 11px;
  background: #ffffff;
  border: 1px solid var(--bd);
}

.lp .streak-days span i {
  font-style: normal;
  font-size: 11px;
}

.lp .streak-days .d-on {
  border-color: rgba(201, 98, 38, 0.35);
  background: rgba(201, 98, 38, 0.15);
  color: #A8430F; 
}

.lp .streak-days .d-shield {
  border-color: rgba(42, 76, 176, 0.35);
  background: rgba(42, 76, 176, 0.12);
}

.lp .roast-bubble span {
  font-size: 10px;
  letter-spacing: 0.08em;
  color: #B3203C; 
  display: block;
  margin-bottom: 4px;
}

.lp .roast-bubble p {
  font-size: 13px !important;
  color: var(--tx) !important;
  font-style: italic;
}

@media (max-width: 820px) {
  .lp .bento {
    grid-template-columns: 1fr;
  }
  .lp .bn {
    grid-column: auto !important;
  }
}

/* How It Works Steps */
.lp .steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}

.lp .steps li {
  padding: 26px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(217, 179, 91, 0.22);
  border-radius: 20px;
  box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
}

.lp .steps h3 {
  font-size: 20px;
  margin: 10px 0 8px;
  color: #ffffff;
}

.lp .steps p {
  margin: 0;
  color: rgba(255, 255, 255, 0.8);
  font-size: 15px;
}

.lp .num {
  font-size: 13px;
  color: #2B2000;
  padding: 4px 10px;
  border-radius: 99px;
  background: linear-gradient(135deg, #F3E2AA, #D9B35B);
  font-weight: bold;
}

/* Pricing & Matrix Table */
.lp .plans {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 22px;
}

.lp .plan {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 30px;
  background: var(--s1);
  border-radius: 24px;
  border: 1px solid var(--bd);
}

.lp .plan h3 {
  font-size: 18px;
  color: var(--mut);
}

.lp .plan p {
  margin: 10px 0 0;
  color: var(--mut);
  font-size: 15px;
}

.lp .plan .price {
  font-size: 54px;
  font-weight: 700;
  color: var(--tx);
  letter-spacing: -0.04em;
  margin: 8px 0 0;
}

.lp .price small {
  font-size: 15px;
  font-weight: 400;
  color: var(--mut);
}

.lp .beam {
  border-color: transparent;
}

.lp .beam::before {
  content: "";
  position: absolute;
  inset: -80%;
  z-index: -2;
  background: conic-gradient(from 0deg, transparent 0 60%, #D9B35B 80%, #2F55C8 92%, transparent);
  animation: spin 5s linear infinite;
}

.lp .beam::after {
  content: "";
  position: absolute;
  inset: 1.5px;
  border-radius: 23px;
  z-index: -1;
  background: linear-gradient(180deg, #FBF4DD, #F6F1E6 45%);
}

@media (max-width: 640px) {
  .lp .plans {
    grid-template-columns: 1fr;
  }
}

.lp .tablewrap {
  overflow-x: auto;
  border: 1px solid rgba(217, 179, 91, 0.28);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
}

.lp .matrix {
  width: 100%;
  min-width: 520px;
  border-collapse: collapse;
}

.lp .matrix th,
.lp .matrix td {
  padding: 14px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
}

.lp .matrix th:first-child,
.lp .matrix td:first-child {
  text-align: left;
}

.lp .matrix tbody th {
  font-weight: 500;
  color: #ffffff;
}

.lp .matrix thead th {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(217, 179, 91, 0.10);
}

.lp .matrix thead b {
  color: #ffffff;
  margin-left: 6px;
}

.lp .matrix thead span {
  font-size: 12px;
  margin-left: 4px;
}

.lp .matrix tbody tr {
  transition: background 0.2s;
}

.lp .matrix tbody tr:hover {
  background: rgba(255, 255, 255, 0.1);
}

.lp .matrix tbody tr:last-child > * {
  border-bottom: 0;
}

.lp .yes {
  color: #EBCB7E;
  font-weight: 800;
}

.lp .no {
  color: rgba(255, 255, 255, 0.5);
}

.lp .fine {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
  margin-top: 14px;
}

/* FAQ Accordion */
.lp .faq {
  max-width: 780px;
  margin: 0 auto;
  display: grid;
  gap: 10px;
}

.lp .faq details {
  background: var(--s1);
  border: 1px solid var(--bd);
  border-radius: 16px;
  box-shadow: 0 4px 15px -10px rgba(14, 27, 51, 0.15);
  transition: border-color 0.3s;
}

.lp .faq details[open] {
  border-color: rgba(154, 98, 0, 0.55);
}

.lp .faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 56px;
  padding: 14px 20px;
  cursor: pointer;
  list-style: none;
}

.lp .faq summary::-webkit-details-marker {
  display: none;
}

.lp .faq summary h3 {
  font-size: 16px;
  letter-spacing: -0.02em;
  line-height: 1.35;
  font-weight: 600;
}

.lp .pm {
  position: relative;
  flex: none;
  width: 18px;
  height: 18px;
  transition: transform 0.45s var(--ease-spring);
}

.lp .pm::before,
.lp .pm::after {
  content: "";
  position: absolute;
  left: 0;
  top: 8px;
  width: 18px;
  height: 2px;
  border-radius: 2px;
  background: var(--v2);
}

.lp .pm::after {
  transform: rotate(90deg);
}

.lp details[open] .pm {
  transform: rotate(45deg);
}

.lp .faq p {
  margin: 0;
  padding: 0 20px 20px;
  color: var(--mut);
}

/* Finale CTA + Footer */
.lp .finale {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 72px 24px;
  border-radius: 28px;
  border: 1px solid rgba(217, 179, 91, 0.38);
  box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.12), 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  color: #ffffff;
  background: radial-gradient(ellipse 70% 90% at 50% 130%, rgba(217, 179, 91, 0.42), transparent 70%), linear-gradient(160deg, #16308A, #0C1A44 70%);
}

.lp .finale::before {
  content: "";
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, #EBCB7E, transparent);
}

.lp .finale .sub {
  margin-bottom: 28px;
  color: rgba(231, 236, 248, 0.78);
}

.lp .foot {
  margin-top: 84px;
  border-top: 1px solid rgba(217, 179, 91, 0.25);
  padding: 30px 0 calc(36px + env(safe-area-inset-bottom, 0px));
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
}

.lp .foot nav {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 22px;
}

.lp .foot nav a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
}

.lp .foot nav a:hover {
  color: #ffffff;
}

.lp .foot p {
  margin: 8px 0 0;
}

/* GPU Keyframes */
@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  50% { opacity: 0.45; }
}

@keyframes drift {
  from { transform: translate3d(-40px, 0, 0) rotate(0deg); }
  to { transform: translate3d(60px, 40px, 0) rotate(25deg); }
}

@keyframes rise {
  from { opacity: 0; transform: translate3d(0, 22px, 0); filter: blur(8px); }
  to { opacity: 1; transform: none; filter: none; }
}

@keyframes eq {
  50% { transform: scaleY(1); }
}

@keyframes scanLaser {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(144px); }
}

@keyframes miniScan {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(58px); }
}

@keyframes grow {
  from { transform: scaleX(0); }
}

@keyframes marq {
  to { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .lp *,
  .lp *::before,
  .lp *::after {
    animation: none !important;
    transition: none !important;
  }
  .lp .eq i {
    transform: scaleY(0.7);
  }
}

/* =========================================================
   LIVE SANDBOX: self-contained ivory theme
   Re-declares every token the demo uses, so it looks right
   no matter what the page-level (:root / .lp) tokens are.
   The inline `var(--bg)` on inputs and selects now resolves
   to a light cream field instead of the dark page navy.
   ========================================================= */
.lp .sandbox-app {
  --bg: #FBF8F1;
  --card: #FBF8F1;
  --tx: #0E1B33;
  --mut: rgba(14, 27, 51, 0.66);
  --bd: rgba(14, 27, 51, 0.14);
  --ok: #9A6200;
  --bad: #B3203C;
  --ac: #2A4CB0;
  --ac2: #D9B35B;
  --warn: #C96226;
  background: #EDE5D2;
  color: var(--tx);
}

.lp .sandbox-app .top {
  background: #F6F1E6;
  border-bottom: 1px solid var(--bd);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.lp .sandbox-app .logo { color: var(--tx); }
.lp .sandbox-app .logo i { color: var(--ac); }

.lp .sandbox-app nav button { color: var(--mut); }
.lp .sandbox-app nav button:hover { color: var(--tx); }
.lp .sandbox-app nav button.on { background: rgba(217, 179, 91, 0.30); color: var(--tx); }

.lp .sandbox-app .card {
  background-color: #FBF8F1;
  border: 1px solid var(--bd);
