  proSince      DateTime?
  lsOrderId     String?
  lsCustomerId  String?
  
  accounts      Account[]
  sessions      Session[]
  
  // New tables connected to the user
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- NEW FINANCIAL TABLES ---

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  type        String   // "IN" or "OUT"
  category    String
  note        String?
