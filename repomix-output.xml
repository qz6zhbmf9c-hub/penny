  .txform .txbtn .ico { font-size: 22px; line-height: 1; }
  .txform .txbtn .lbl { display: inline; }
  .txform select, .txform input { width: 100%; min-width: 0; min-height: 48px; padding: 10px 14px; border-radius: 0.875rem; box-sizing: border-box; }
  .txform .f-amt, .txform .f-date, .txform .f-type, .txform .f-cat, .txform .f-note { width: 100%; min-width: 0; flex: none; }
  .txform input[type="date"] { -webkit-appearance: none; appearance: none; text-align: left; }
  .txform .f-add { width: 100%; min-height: 52px; border-radius: 1rem; font-size: 16px; }
  .stackform > * { flex: 1 1 100%; }
  .stackform button { min-height: 48px; }

  /* Transaction rows */
  .tx { gap: 0.75rem; padding: 0.875rem 0; }
  .tx .m { min-width: 0; }
  .tx .m b, .tx .m .sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tx > b { white-space: nowrap; }

  /* 5. Charts scale to the card, never scroll sideways */
  .donut-wrap { flex-direction: column; align-items: stretch; gap: 14px; }
  .donut-svg { width: min(220px, 72vw); margin: 0 auto; display: block; }
  .donut-legend { width: 100%; min-width: 0; }

  /* Toast floats above the tab bar */
  #toast {
    left: 50%; right: auto; bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    max-width: calc(100vw - 32px); text-align: center; border-radius: 999px; padding: 0.65rem 1.1rem;
    transform: translate(-50%, 1rem);
  }
  #toast.on { transform: translate(-50%, 0); }
}

/* Very small phones (iPhone SE and narrower) */
@media (max-width: 400px) {
