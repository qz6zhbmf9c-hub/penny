  .tabbar button.on .ic::before { opacity: 1; transform: scale(1); }
  .tabbar button:active .ic { transform: scale(0.9); }
  .tabbar .ic svg { position: relative; width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .tabbar button.on .ic svg { stroke: var(--ac); }
  .tabbar span:last-child { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .mobile-only { display: block; }

  /* 3. Spacing: more room for the content, grids stack */
  main { padding: 16px max(16px, env(safe-area-inset-right)) calc(96px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left)); }
  .grid { gap: 0.875rem; }
  .grid > * { min-width: 0; }
  .g2, .g4 { grid-template-columns: 1fr; }
  .card { padding: 1.25rem; border-radius: 1.25rem; }
  .big { font-size: 1.75rem; overflow-wrap: anywhere; }
  .card.hero .big { font-size: 2.25rem; }

  /* Touch targets + no iOS zoom-on-focus */
