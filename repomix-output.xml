  --mut: #8A93A6;
  --ease-out-expo: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
  background: var(--bg);
  color: var(--tx);
  min-height: 100vh;
