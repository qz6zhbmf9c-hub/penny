  border-radius: 8px;
}

.lp .mono {
  font-family: "JetBrains Mono", ui-monospace, monospace;
  font-variant-numeric: tabular-nums;
}

.lp .sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.lp .wrap {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 20px;
}

.lp h1,
.lp h2,
.lp h3 {
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.06;
  margin: 0;
}

.lp em {
  font-family: "Instrument Serif", Georgia, serif;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -0.015em;
  padding-right: 0.06em;
  background: linear-gradient(120deg, #DDD6FE, #A78BFA 50%, #34D399);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.lp .sec {
  padding: 88px 20px 0;
}

.lp h2 {
  font-size: clamp(30px, 5vw, 48px);
  text-align: center;
}

.lp .sub {
  color: var(--mut);
  text-align: center;
  max-width: 620px;
  margin: 14px auto 38px;
