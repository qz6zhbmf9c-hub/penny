@import "tailwindcss";

@config "../../tailwind.config.ts";



:root {

  /* === Penny "Private Bank" Ivory Theme (Matching the Sandbox) === */

  --bg: #EDE5D2;

  --card: #FBF8F1;

  --bd: rgba(14, 27, 51, 0.14);

  --tx: #0E1B33;

  --mut: rgba(14, 27, 51, 0.66);

  --ok: #9A6200;

  --bad: #B3203C;

  --ac: #2A4CB0;

  --ac2: #D9B35B;

  --warn: #C96226;

}



body {

  background-color: var(--bg);

  color: var(--tx);

  font-family: ui-sans-serif, system-ui, sans-serif;

  margin: 0;

  min-height: 100vh;

}



/* --- Layout --- */

.top { display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; border-bottom: 1px solid var(--bd); background: #F6F1E6; position: sticky; top: 0; z-index: 10; }

main { padding: 2rem; max-width: 1152px; margin: 0 auto; }

.grid { display: grid; gap: 1rem; }

.g2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }

.g4 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }



/* --- Components --- */

.card { background-color: var(--card); border: 1px solid var(--bd); border-radius: 1rem; padding: 1.5rem; box-shadow: 0 8px 24px -14px rgba(14, 27, 51, 0.35); }

.card.hero { background: linear-gradient(135deg, rgba(217, 179, 91, 0.26), rgba(251, 248, 241, 0) 62%), var(--card); border-color: rgba(154, 98, 0, 0.35); }

.card h3 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mut); margin: 0 0 0.5rem 0; font-weight: 600; }



/* --- Typography --- */

.big { font-size: 2rem; font-weight: 800; margin: 0.25rem 0; color: var(--tx); }

.sub { font-size: 0.875rem; color: var(--mut); }

.pos { color: var(--ok); }

.neg { color: var(--bad); }

.logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.025em; color: var(--tx); }

.logo i { color: var(--ac); font-style: normal; }



/* --- Controls --- */

button, a { cursor: pointer; font-family: inherit; font-size: 0.875rem; transition: 0.2s; text-decoration: none; }

button:disabled { opacity: 0.5; cursor: not-allowed; }



button.p, a.p { display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0E1B33, #1E3577); color: #F6F1E6; font-weight: 600; padding: 0.5rem 1rem; border-radius: 0.75rem; border: none; box-shadow: 0 4px 14px rgba(14, 27, 51, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.14); }

button.p:hover:not(:disabled), a.p:hover { transform: translateY(-1px); }



button.s, a.s { display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--bd); color: var(--tx); padding: 0.5rem 1rem; border-radius: 0.75rem; font-weight: 600; }

button.s:hover:not(:disabled), a.s:hover { border-color: var(--ac); background: rgba(14, 27, 51, 0.05); text-decoration: none; }



