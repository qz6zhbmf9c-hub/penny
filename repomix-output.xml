}

/* Glass surfaces */
.lp .gl {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0)), var(--s2);
  border: 1px solid var(--bd);
  border-radius: 20px;
  box-shadow: var(--spec), 0 20px 50px -24px rgba(0, 0, 0, 0.85);
}

/* Sticky Glass Pill Navbar */
.lp .nav {
  position: sticky;
  top: 0;
  z-index: 30;
  padding: calc(12px + env(safe-area-inset-top, 0px)) 16px 0;
}

.lp .pill {
  max-width: 980px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 8px 8px 8px 20px;
  min-height: 56px;
  border-radius: 99px;
  background: rgba(10, 13, 20, 0.72);
